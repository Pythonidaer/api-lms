{
  "openapi": "3.1.0",
  "info": {
    "title": "API LMS Tasks fixture",
    "version": "1.0.0",
    "description": "Original synthetic loopback teaching API. Public demo labels are not production credentials. Bounded, memory-only state; restart resets everything. Unsupported methods use 405; unknown routes use 404. Reader files are outside this API contract."
  },
  "servers": [
    {
      "url": "http://localhost:8000/api/v1",
      "description": "Local practice server only"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Public synthetic health check",
        "responses": {
          "200": {
            "description": "Fixture is running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "405": {
            "description": "Unsupported method; Allow lists fixture operations.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/tasks": {
      "get": {
        "operationId": "listTasks",
        "summary": "List only the caller\u2019s visible tasks",
        "responses": {
          "200": {
            "description": "Ordered by numeric ID; not a snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskPage"
                }
              }
            }
          },
          "400": {
            "description": "Malformed syntax, query, cursor or idempotency key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid demo identity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer challenge",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "405": {
            "description": "Unsupported method; Allow lists fixture operations.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Single-digit decimal 1\u20133.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3,
              "default": 2
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Optional exact status filter.",
            "schema": {
              "type": "string",
              "enum": [
                "open",
                "done"
              ]
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque returned cursor, same caller/filter. Unknown or repeated query keys return 400.",
            "schema": {
              "type": "string",
              "maxLength": 256
            }
          }
        ]
      },
      "post": {
        "operationId": "createTask",
        "summary": "Create a caller-owned task",
        "responses": {
          "201": {
            "description": "New task or replay of original creation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "URI of the created task",
                "schema": {
                  "type": "string"
                }
              },
              "Idempotent-Replay": {
                "description": "true when replayed",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Malformed syntax, query, cursor or idempotency key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid demo identity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer challenge",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Write scope required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency key used with different input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 16384 bytes",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported media type",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid writable fields or values",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Synthetic throttling or bounded fixture capacity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Wait in seconds",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "405": {
            "description": "Unsupported method; Allow lists fixture operations.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "Optional caller-scoped key. Same trimmed title replays for ten minutes while the bounded cache retains it. Changed input \u2192 409; restarting clears retention.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[!-~]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskCreate"
              }
            }
          }
        }
      }
    },
    "/tasks/{id}": {
      "get": {
        "operationId": "getTask",
        "summary": "Read a visible task",
        "responses": {
          "200": {
            "description": "Task representation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "Current exact validator for conditional reading/writing.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "Cached representation remains valid; no body",
            "headers": {
              "ETag": {
                "description": "Current exact validator for conditional reading/writing.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid demo identity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer challenge",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Resource or route not visible",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "405": {
            "description": "Unsupported method; Allow lists fixture operations.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Task identity; never confers access.",
            "schema": {
              "type": "string",
              "pattern": "^t[1-9][0-9]*$"
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "required": false,
            "description": "Fixture supports an exact single validator match.",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "patch": {
        "operationId": "updateTask",
        "summary": "Update title/status conditionally",
        "responses": {
          "200": {
            "description": "Updated task and new validator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            },
            "headers": {
              "ETag": {
                "description": "Current exact validator for conditional reading/writing.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Malformed syntax, query, cursor or idempotency key",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid demo identity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer challenge",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Write scope required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Resource or route not visible",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "412": {
            "description": "Stale If-Match validator",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 16384 bytes",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported media type",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Invalid writable fields or values",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "428": {
            "description": "If-Match is required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "405": {
            "description": "Unsupported method; Allow lists fixture operations.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Task identity; never confers access.",
            "schema": {
              "type": "string",
              "pattern": "^t[1-9][0-9]*$"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "Exact current ETag; missing 428, stale 412. This fixture supports one exact validator, not wildcard/list variants.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskPatch"
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteTask",
        "summary": "Delete a visible task",
        "responses": {
          "204": {
            "description": "Removed; no body"
          },
          "401": {
            "description": "Missing or invalid demo identity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer challenge",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Write scope required",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Resource or route not visible",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "405": {
            "description": "Unsupported method; Allow lists fixture operations.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Task identity; never confers access.",
            "schema": {
              "type": "string",
              "pattern": "^t[1-9][0-9]*$"
            }
          }
        ]
      }
    },
