                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid demo identity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
