    "/operations/{id}": {
      "get": {
        "operationId": "getOperation",
        "summary": "Poll an owned synthetic operation",
        "responses": {
          "200": {
            "description": "Current operation state; count computed at poll time",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid demo identity",
            "content": {
              "application/problem+json": {
