{
  "info": {
    "name": "API LMS \u2014 Tasks contract practice",
    "description": "Run in order against a fresh local fixture. Public demo tokens only. Restart the server before repeating a full run. Uses collection variables for generated IDs and validators.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v1"
    },
    {
      "key": "token",
      "value": "demo-alice"
    },
    {
      "key": "createKey",
      "value": "postman-practice-create"
    }
  ],
  "item": [
    {
      "name": "01 Public health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Fixture identity\", () => pm.expect(pm.response.json().fixture).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Missing identity",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"Problem media type\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 List one visible task",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks?limit=1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Bounded page\", () => pm.expect(pm.response.json().items).to.have.lengthOf(1));",
              "pm.test(\"Owner field stays private\", () => pm.expect(pm.response.json().items[0]).not.to.have.property(\"owner\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Create task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{createKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Practice API contract\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"createdId\", pm.response.json().id);",
              "pm.test(\"Location\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(pm.response.json().id));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Replay creation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{createKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Practice API contract\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Same task\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"createdId\")));",
              "pm.test(\"Replay marker\", () => pm.expect(pm.response.headers.get(\"Idempotent-Replay\")).to.eql(\"true\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Different input conflicts",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{createKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Different intended task\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Read created task",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks/{{createdId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"originalEtag\", pm.response.headers.get(\"ETag\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Conditional update",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "If-Match",
            "value": "{{originalEtag}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tasks/{{createdId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"status\": \"done\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"State changed\", () => pm.expect(pm.response.json().status).to.eql(\"done\"));",
              "pm.test(\"Version advanced\", () => pm.expect(pm.response.json().version).to.eql(2));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Stale update denied",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "If-Match",
            "value": "{{originalEtag}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tasks/{{createdId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Overwrite attempt\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 412\", () => pm.response.to.have.status(412));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Other owner denied",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks/t4"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Reject owner assignment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Forbidden field\", \"owner\": \"bob\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 422\", () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Synthetic throttling",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/demo/rate-limit"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 429\", () => pm.response.to.have.status(429));",
              "pm.test(\"Retry hint\", () => pm.expect(pm.response.headers.get(\"Retry-After\")).to.eql(\"1\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Delete created task",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/tasks/{{createdId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Confirm absence",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks/{{createdId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
